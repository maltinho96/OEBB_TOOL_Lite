{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OEBB-Tool",
  "version": "0.5.0",
  "identifier": "de.nettec.oebbtool",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ÖBB-Tool",
        "width": 1280,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Malte Lenzen",
    "shortDescription": "Protokolle der ökologischen Baubegleitung",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "German"
        ],
        "displayLanguageSelector": false,
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "copyright": "Malte Lenzen",
    "linux": {
      "deb": {
        "postRemoveScript": "./linux/postrm.sh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVEQjNFQkFCRkQzRjAwQ0EKUldUS0FELzlxK3V6N2NibnIxRFFBY3JhVGs2a1ZEd3p0WmJIcENvNlBnSmhZdXNCZHo4SEZESUYK",
      "endpoints": [
        "https://github.com/maltinho96/OEBB_TOOL_Lite/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
